#!/usr/bin/env bash
# Usage: herdr-ghq-open <workspace|tab>
#
# ghq のリポジトリを曖昧検索し、独立した作業なら workspace として、
# 現在の作業に追加するなら tab として開く。

set -euo pipefail

action="${1:-}"
case "$action" in
workspace | tab) ;;
*)
    echo "Usage: herdr-ghq-open <workspace|tab>" >&2
    exit 1
    ;;
esac

repos=$(ghq list -p)
[[ -z "$repos" ]] && exit 0

# 候補を先に確定し、fzf の早期終了で ghq が SIGPIPE になるのを避ける。
repo=$(
    fzf --bind=tab:down,shift-tab:up,btab:up \
        --reverse \
        --preview-window=down:40% \
        --preview 'git -C {} log --oneline --graph --decorate --color=always -n 20 2>/dev/null || ls -la {}' \
        --header="enter で $action として開く" \
        <<<"$repos"
) || exit 0
[[ -z "$repo" ]] && exit 0

# repo 自体、またはその配下を cwd にしている最初の pane を返す。
# foreground_cwd は foreground process が別の cwd を持つ場合も拾う。
find_pane() {
    local workspace_id="${1:-}"
    local -a list_args=()
    [[ -n "$workspace_id" ]] && list_args=(--workspace "$workspace_id")

    herdr pane list "${list_args[@]}" |
        jq -r --arg repo "$repo" '
            first((.result.panes // [])[]
                | select(
                    .cwd == $repo
                    or (.cwd | startswith($repo + "/"))
                    or .foreground_cwd == $repo
                    or ((.foreground_cwd // "") | startswith($repo + "/"))
                )
                | [.workspace_id, .tab_id]
                | @tsv
            ) // empty
        '
}

case "$action" in
workspace)
    match=$(find_pane)
    if [[ -n "$match" ]]; then
        IFS=$'\t' read -r workspace_id _ <<<"$match"
        herdr workspace focus "$workspace_id" >/dev/null
    else
        herdr workspace create \
            --cwd "$repo" --label "$(basename "$repo")" --focus >/dev/null
    fi
    ;;
tab)
    # popup custom command では ACTIVE_*、通常の herdr pane では非 ACTIVE の
    # caller context が渡るため、後者をフォールバックにする。
    active_workspace_id="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"
    if [[ -z "$active_workspace_id" ]]; then
        echo "herdr-ghq-open: active workspace is unavailable" >&2
        exit 1
    fi

    match=$(find_pane "$active_workspace_id")
    if [[ -n "$match" ]]; then
        IFS=$'\t' read -r _ tab_id <<<"$match"
        herdr tab focus "$tab_id" >/dev/null
    else
        herdr tab create --workspace "$active_workspace_id" \
            --cwd "$repo" --label "$(basename "$repo")" --focus >/dev/null
    fi
    ;;
esac
