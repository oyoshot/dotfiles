#compdef claude

_claude() {
  local context state line
  typeset -A opt_args

  _arguments -s -S \
    '*--add-dir=[Add a directory that tools may access]:directory:_directories' \
    '--agent=[Use a configured agent]:agent:' \
    '--agents=[Define agents as JSON]:JSON:' \
    '--allowed-tools=[Comma or space-separated tools to allow]:tools:' \
    '--disallowed-tools=[Comma or space-separated tools to deny]:tools:' \
    '--append-system-prompt=[Append text to the system prompt]:prompt:' \
    '--append-system-prompt-file=[Append a file to the system prompt]:file:_files' \
    '--system-prompt=[Set the system prompt]:prompt:' \
    '--system-prompt-file=[Read the system prompt from a file]:file:_files' \
    '--effort=[Set effort level]:level:(low medium high max)' \
    '--fallback-model=[Use this model when the primary model is overloaded]:model:' \
    '*--file=[Download a file resource (file_id:path)]:file specification:' \
    '--input-format=[Set input format]:format:(text stream-json)' \
    '--output-format=[Set output format]:format:(text json stream-json)' \
    '--max-budget-usd=[Set maximum API budget]:amount:' \
    '*--mcp-config=[Load an MCP configuration]:config:_files' \
    '--model=[Select a model]:model:' \
    '--name=[Set the session display name]:name:' \
    '--permission-mode=[Set permission mode]:mode:(acceptEdits bypassPermissions default dontAsk plan auto)' \
    '*--plugin-dir=[Load plugins from a directory]:directory:_directories' \
    '--session-id=[Use a session UUID]:UUID:' \
    '--setting-sources=[Select setting sources]:sources:(user project local)' \
    '--settings=[Load settings from a file or JSON]:settings:_files' \
    '--tools=[Select built-in tools]:tools:' \
    '--worktree=-[Start in a worktree]:name:' \
    '(-c --continue)'{-c,--continue}'[Continue the latest session]' \
    '(-p --print)'{-p,--print}'[Print a response and exit]' \
    '(-r --resume)'{-r,--resume}'=-[Resume a session]:session:' \
    '(-d --debug)'{-d,--debug}'=-[Enable debug logging]:filter:' \
    '(-v --version)'{-v,--version}'[Show version]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '--bare[Use minimal non-interactive mode]' \
    '--brief[Enable agent-to-user messages]' \
    '--chrome[Enable Chrome integration]' \
    '--no-chrome[Disable Chrome integration]' \
    '--fork-session[Fork when resuming a session]' \
    '--ide[Connect to an available IDE]' \
    '--include-partial-messages[Include partial streaming messages]' \
    '--no-session-persistence[Do not save the session]' \
    '--replay-user-messages[Replay input messages on output]' \
    '--strict-mcp-config[Ignore other MCP configurations]' \
    '--tmux=-[Create a tmux session for a worktree]:mode:(classic)' \
    '--verbose[Enable verbose output]' \
    '--dangerously-skip-permissions[Bypass permission checks]' \
    '--allow-dangerously-skip-permissions[Allow permission bypass mode]' \
    '1:command:->command' \
    '*::argument:->arguments'

  case $state in
    command)
      _describe -t commands 'command' (
        'agents:List configured agents'
        'auth:Manage authentication'
        'auto-mode:Inspect auto mode configuration'
        'doctor:Check updater health'
        'install:Install the Claude Code native build'
        'mcp:Configure MCP servers'
        'plugin:Manage plugins'
        'plugins:Manage plugins'
        'setup-token:Set up a long-lived authentication token'
        'update:Update Claude Code'
        'upgrade:Update Claude Code'
      )
      ;;
    arguments)
      case $words[2] in
        install) _values 'target' stable latest ;;
        *) _default ;;
      esac
      ;;
  esac
}

_claude "$@"
